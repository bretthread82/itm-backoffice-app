#--------------------------------------------------------------------
# ITM Back Office: production environment template
# Copy to .env on the server (never commit the real file) and fill in.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

# Public URL, with trailing slash. HTTPS is enforced in production.
app.baseURL = 'https://backoffice.example.com/'

# Behind a reverse proxy / load balancer that terminates TLS? Also set $proxyIPs in
# app/Config/App.php (see docs/DEPLOYMENT.md), or HTTPS redirects will loop.

#--------------------------------------------------------------------
# DATABASE (MySQL 8, utf8mb4)
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = itm_backoffice
database.default.username = itm_app
database.default.password = 'CHANGE-ME'
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# REDIS: cache (permission lookups, Entra token/keys) and sessions
#--------------------------------------------------------------------
cache.handler = redis
cache.prefix = 'itm_'
cache.redis.host = 127.0.0.1
cache.redis.port = 6379
# cache.redis.password = ''

session.driver = 'CodeIgniter\Session\Handlers\RedisHandler'
session.savePath = 'tcp://127.0.0.1:6379'
# With a password: 'tcp://127.0.0.1:6379?auth=YOUR-PASSWORD'

#--------------------------------------------------------------------
# ENCRYPTION KEY (generate once with: php spark key:generate)
#--------------------------------------------------------------------
# encryption.key = hex2bin:...

#--------------------------------------------------------------------
# EMAIL (notification emails are skipped until a sender is set; password reset by
# email also needs this, otherwise users are told to ask an administrator)
#--------------------------------------------------------------------
# email.fromEmail = 'backoffice@example.com'
# email.fromName = 'ITM Back Office'
# email.protocol = smtp
# email.SMTPHost = smtp.example.com
# email.SMTPUser = 'user'
# email.SMTPPass = 'pass'
# email.SMTPPort = 587
# email.SMTPCrypto = tls

#--------------------------------------------------------------------
# MICROSOFT ENTRA ID (optional). Leave disabled until configured.
#--------------------------------------------------------------------
entra.enabled = false
entra.tenantId = '00000000-0000-0000-0000-000000000000'
entra.clientId = '00000000-0000-0000-0000-000000000000'
entra.clientSecret = 'YOUR-CLIENT-SECRET'
# entra.redirectUri = 'https://backoffice.example.com/auth/entra/callback'
# entra.jitProvisioning = true
# entra.linkExistingByEmail = true
# entra.syncCreatesUsers = true
# entra.syncDeactivates = true
# entra.deactivateLimitPercent = 25

#--------------------------------------------------------------------
# DUO UNIVERSAL PROMPT (optional second factor)
# Placeholders are ignored until replaced with real values from the Duo
# Admin Panel (Applications > Protect an Application > Web SDK).
#--------------------------------------------------------------------

duo.clientId = 'YOUR-DUO-CLIENT-ID'
duo.clientSecret = 'YOUR-DUO-CLIENT-SECRET'
duo.apiHost = 'api-XXXXXXXX.duosecurity.com'
# duo.redirectUri = 'https://backoffice.example.com/mfa/duo/callback'
