{
  "openapi": "3.1.0",
  "info": {
    "title": "Maloney Group Invoice Approval & Tracking API",
    "version": "1.0.0",
    "description": "Read-only access to invoice data.\n\n**Authentication.** Ask an administrator to make you a token (Administration > API tokens) and send it as `Authorization: Bearer <token>`. A token acts as its owner: it sees exactly the companies its owner can see (group-level users see all), never more. Browser sessions do not work on this API.\n\n**Errors.** Every error is `{\"error\": {\"code\": \"...\", \"message\": \"...\"}}`. An invoice you cannot see is reported as 404, the same as one that does not exist.\n\n**Limits.** 120 requests per minute per client and token; beyond that you get 429 with `Retry-After`.\n\n**Money and dates.** Amounts are strings with two decimals plus a currency code. Dates are `YYYY-MM-DD`; timestamps are server local time."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "This server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Account"
    },
    {
      "name": "Invoices"
    },
    {
      "name": "Approvals"
    },
    {
      "name": "Reports"
    },
    {
      "name": "Description"
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "tags": [
          "Account"
        ],
        "operationId": "getMe",
        "summary": "Who this token belongs to",
        "description": "The token owner, whether they are a group-level user, the companies they can see, and the token's own name, scopes and expiry.",
        "responses": {
          "200": {
            "description": "The token owner.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Me"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/companies": {
      "get": {
        "tags": [
          "Account"
        ],
        "operationId": "listCompanies",
        "summary": "Companies you can see",
        "responses": {
          "200": {
            "description": "Companies.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Company"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/invoices": {
      "get": {
        "tags": [
          "Invoices"
        ],
        "operationId": "listInvoices",
        "summary": "List invoices",
        "description": "Newest first unless sorted. Only invoices in companies you can see.",
        "parameters": [
          {
            "name": "company",
            "in": "query",
            "description": "Only this company. It must be one you can see; otherwise 422.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "One status, or a group: `open` (in approval or approved), `outstanding` (not yet paid: open, returned, or processed and waiting to be paid) or `completed` (processed or paid; the old name for finished, kept for existing clients).",
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "outstanding",
                "draft",
                "in_approval",
                "approved",
                "returned",
                "rejected",
                "cancelled",
                "processed",
                "paid",
                "completed"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Matches invoice number, supplier or PO / reference (contains).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "age",
            "in": "query",
            "description": "Days past due band.",
            "schema": {
              "type": "string",
              "enum": [
                "overdue",
                "current",
                "1-30",
                "31-60",
                "61-90",
                "90+",
                "critical"
              ]
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "description": "Invoice date on or after.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "description": "Invoice date on or before.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "min",
            "in": "query",
            "description": "Amount at least.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max",
            "in": "query",
            "description": "Amount at most.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort field.",
            "schema": {
              "type": "string",
              "enum": [
                "invoice",
                "supplier",
                "invoice_date",
                "due",
                "amount",
                "status",
                "company"
              ]
            }
          },
          {
            "name": "dir",
            "in": "query",
            "description": "Sort direction (default desc).",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number, from 1.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Rows per page, up to 100.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of invoices.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Invoice"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/InvalidFilter"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/invoices/{id}": {
      "get": {
        "tags": [
          "Invoices"
        ],
        "operationId": "getInvoice",
        "summary": "One invoice",
        "description": "Adds the approval route steps, the step the invoice is waiting at, and the attached PDF's details.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Invoice id."
          }
        ],
        "responses": {
          "200": {
            "description": "The invoice.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/InvoiceDetail"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/invoices/{id}/timeline": {
      "get": {
        "tags": [
          "Invoices"
        ],
        "operationId": "getInvoiceTimeline",
        "summary": "Approval history",
        "description": "Actions and notes, oldest first.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Invoice id."
          }
        ],
        "responses": {
          "200": {
            "description": "Events.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TimelineEvent"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/invoices/{id}/file": {
      "get": {
        "tags": [
          "Invoices"
        ],
        "operationId": "getInvoiceFile",
        "summary": "Download the invoice PDF",
        "description": "404 once the server copy has been purged after retention (the invoice's SharePoint copy is unaffected).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Invoice id."
          }
        ],
        "responses": {
          "200": {
            "description": "The PDF.",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/invoices/{id}/documents/{docId}": {
      "get": {
        "tags": [
          "Invoices"
        ],
        "operationId": "getInvoiceDocument",
        "summary": "Download a supporting document",
        "description": "A document attached during approval (listed in `documents` on the invoice). 404 once the server copy has been purged after retention.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Invoice id."
          },
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Document id."
          }
        ],
        "responses": {
          "200": {
            "description": "The document, with its own content type.",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/approvals": {
      "get": {
        "tags": [
          "Approvals"
        ],
        "operationId": "listApprovals",
        "summary": "Work waiting on the token owner",
        "description": "`view=waiting` (default): invoices waiting on the owner as named approver, delegate or team member, oldest first. `view=mine`: the owner's own unfinished invoices, grouped as waiting, needs_action and drafts.",
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "description": "Which list.",
            "schema": {
              "type": "string",
              "enum": [
                "waiting",
                "mine"
              ],
              "default": "waiting"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Queue items. For `waiting` an array; for `mine` an object with `waiting`, `needs_action` and `drafts` arrays.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "oneOf": [
                        {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/QueueItem"
                          }
                        },
                        {
                          "type": "object",
                          "properties": {
                            "waiting": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/QueueItem"
                              }
                            },
                            "needs_action": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/QueueItem"
                              }
                            },
                            "drafts": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/QueueItem"
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/InvalidFilter"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/reports/outstanding": {
      "get": {
        "tags": [
          "Reports"
        ],
        "operationId": "getOutstandingReport",
        "summary": "Outstanding invoices and ageing summary",
        "description": "Invoices still in approval, approved or returned, with days past due, plus totals per ageing band and per company. Totals are per currency.",
        "parameters": [
          {
            "name": "company",
            "in": "query",
            "description": "Only this company. It must be one you can see; otherwise 422.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "group",
            "in": "query",
            "description": "A sub-group id (includes the groups beneath it).",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The report.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/OutstandingReport"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/InvalidFilter"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "Description"
        ],
        "operationId": "getOpenApi",
        "summary": "This description",
        "security": [],
        "responses": {
          "200": {
            "description": "The OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "A personal API token issued by an administrator (Administration > API tokens). Scope `api.read`."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing, wrong, revoked or expired token.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The account is inactive, or the token lacks the `api.read` scope.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "No such invoice, or it is not in a company you can see.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "InvalidFilter": {
        "description": "A filter value is not valid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            },
            "description": "Seconds to wait."
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "examples": [
                  "not_found",
                  "unauthorized",
                  "invalid_filter",
                  "rate_limited"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Meta": {
        "type": "object",
        "required": [
          "page",
          "per_page",
          "total",
          "pages"
        ],
        "properties": {
          "page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "pages": {
            "type": "integer"
          }
        }
      },
      "CompanyRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Company": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sub_group": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_group_level": {
            "type": "boolean"
          },
          "companies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          },
          "token": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expires_at": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Server local time, 'YYYY-MM-DD HH:MM:SS'."
              }
            }
          }
        }
      },
      "Invoice": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "invoice_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "supplier": {
            "type": [
              "string",
              "null"
            ]
          },
          "company": {
            "$ref": "#/components/schemas/CompanyRef"
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "invoice_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "amount": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?\\d+\\.\\d{2}$",
            "examples": [
              "1250.50"
            ],
            "description": "Fixed two decimals, as a string so nothing rounds it as a float."
          },
          "currency": {
            "type": "string"
          },
          "po_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "in_approval",
              "approved",
              "returned",
              "rejected",
              "cancelled",
              "processed",
              "paid"
            ]
          },
          "status_label": {
            "type": "string"
          },
          "extra_approval": {
            "type": "boolean"
          },
          "high_priority": {
            "type": "boolean"
          },
          "submitted_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "submitted_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "Server local time, 'YYYY-MM-DD HH:MM:SS'."
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "Server local time, 'YYYY-MM-DD HH:MM:SS'."
          },
          "processed_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the process step was done. Server local time, 'YYYY-MM-DD HH:MM:SS'."
          },
          "paid_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the pay step was done. Server local time, 'YYYY-MM-DD HH:MM:SS'."
          },
          "payment_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "payment_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        }
      },
      "InvoiceDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Invoice"
          },
          {
            "type": "object",
            "properties": {
              "company_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "current_step": {
