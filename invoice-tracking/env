#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# app.baseURL = ''
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

# Behind a load balancer: the balancer addresses/CIDRs to trust for the real client IP
# (login and API rate limits and the audit log use it). Leave unset on a single server.
# app.trustedProxies = '10.0.1.0/24,10.0.2.5'
# app.trustedProxyHeader = 'X-Forwarded-For'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# database.default.hostname = localhost
# database.default.database = ci4
# database.default.username = root
# database.default.password = root
# database.default.DBDriver = MySQLi
# database.default.DBPrefix =
# database.default.port = 3306

# If you use MySQLi as tests, first update the values of Config\Database::$tests.
# database.tests.hostname = localhost
# database.tests.database = ci4_test
# database.tests.username = root
# database.tests.password = root
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

# Long-term analytics: a separate, rebuildable database (same server is fine). Create the schemas and grant the
# app user access, then run `php spark analytics:migrate` (see docs/DEPLOYMENT.md). Tests use database.analyticsTests.*.
# database.analytics.hostname = localhost
# database.analytics.database = invoicing_analytics
# database.analytics.username = root
# database.analytics.password = root
# database.analytics.DBDriver = MySQLi
# database.analytics.port = 3306
# database.analyticsTests.hostname = localhost
# database.analyticsTests.database = invoicing_test_analytics
# database.analyticsTests.username = root
# database.analyticsTests.password = root
# database.analyticsTests.DBDriver = MySQLi
# database.analyticsTests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

# Multi-server (see docs/DEPLOYMENT.md "Running on more than one server"):
# shared sessions and cache so any server can answer any request. Needs the PHP redis extension.
# session.driver = 'CodeIgniter\Session\Handlers\RedisHandler'
# session.savePath = 'tcp://redis.internal:6379?auth=<password>&database=1'

#--------------------------------------------------------------------
# CACHE (also holds the login/API rate-limit counters)
#--------------------------------------------------------------------

# cache.handler = redis
# cache.prefix = invoicing_
# cache.redis.host = redis.internal
# cache.redis.port = 6379
# cache.redis.password = <password>
# cache.redis.database = 0

#--------------------------------------------------------------------
# FILE STORE (invoice PDFs, logos, import staging)
#--------------------------------------------------------------------

# "local" (default) keeps files in writable/uploads on this server. Use "s3" when running more than one server;
# run `php spark files:migrate-to-store` once BEFORE switching existing installs.
# filestore.driver = local
# filestore.s3.bucket = invoicing-files
# filestore.s3.region = us-east-1
# filestore.s3.prefix = prod
# filestore.s3.endpoint =          # only for S3-compatible services (MinIO etc.)
# filestore.s3.pathStyle = false
# filestore.s3.key =               # leave out to use the server's IAM role
# filestore.s3.secret =

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# logger.threshold = 4
# "file" (default) writes to writable/logs on this server. "errorlog" sends logs to PHP's error_log so the
# host's log agent can collect them from every server in one place.
# logger.destination = file
