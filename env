#--------------------------------------------------------------------
# MICROSOFT ENTRA ID (optional)
# Leave entra.enabled = false until you have registered an app in Entra.
# The values below are placeholders and are ignored until replaced with
# real GUIDs and a real secret. Keep the secret out of version control.
#--------------------------------------------------------------------

entra.enabled = false
entra.tenantId = '00000000-0000-0000-0000-000000000000'
entra.clientId = '00000000-0000-0000-0000-000000000000'
entra.clientSecret = 'YOUR-CLIENT-SECRET'
